//@version=5
// RON Scanner — TradingView edition
// Mirrors lib/criteria.js. Fires a webhook alert (JSON) when a symbol
// qualifies as a Tier 1 (5/5) or Tier 2 (>=3/5) pick.
//
// SETUP (see tradingview/README.md):
//   1. Add to a DAILY chart.
//   2. Set the two inputs below per the symbol's sector (Sector name + Sector ETF).
//   3. Create an alert: Condition = "RON pick", "Any alert() function call",
//      "Once Per Bar Close". Paste your webhook URL. Leave the message default
//      (the script builds the JSON payload itself).
indicator("RON Scanner", overlay = true)

// ── Inputs ────────────────────────────────────────────────────────────────
secret    = input.string("CHANGE_ME",  "Webhook secret",  tooltip = "Must match TV_WEBHOOK_SECRET on the server")
sectorNm  = input.string("Technology", "Sector name")
sectorSym = input.symbol("AMEX:XLK",   "Sector ETF",      tooltip = "The SPDR sector ETF for this symbol's sector")

// ── Criterion 1: Sector money flow (from the sector ETF) ───────────────────
// JS: calculateSectorFlow — split last 30 ETF days into two 15-day halves;
//     trending = priceChange > 0 AND volChange > -0.1
[etfClose, etfVol] = request.security(sectorSym, "D", [close, volume])
avgPriceSecond = ta.sma(etfClose, 15)
avgPriceFirst  = ta.sma(etfClose, 15)[15]
avgVolSecond   = ta.sma(etfVol, 15)
avgVolFirst    = ta.sma(etfVol, 15)[15]
secPriceChg = (avgPriceSecond - avgPriceFirst) / avgPriceFirst
secVolChg   = (avgVolSecond - avgVolFirst) / avgVolFirst
c1_sectorFlow = secPriceChg > 0 and secVolChg > -0.1

// ── Criterion 2: Consolidation breakout ────────────────────────────────────
// JS: consolidation window = bars[-130:-30] (100 bars), recent = last 30.
//     met = volChange > 0.25 AND rangePercent < 0.25
recentAvgVol  = ta.sma(volume, 30)
consolAvgVol  = ta.sma(volume, 100)[30]
volChange     = (recentAvgVol - consolAvgVol) / consolAvgVol
consolHigh    = ta.highest(high, 100)[30]
consolLow     = ta.lowest(low, 100)[30]
avgConsolPx   = ta.sma(close, 100)[30]
rangePercent  = (consolHigh - consolLow) / avgConsolPx
c2_consol = volChange > 0.25 and rangePercent < 0.25

// ── Criterion 3: 50-day SMA slope ──────────────────────────────────────────
// JS: slope = sma50(today) - sma50(10 days ago); met = slope >= 0
sma50    = ta.sma(close, 50)
slope    = sma50 - sma50[10]
slopePct = slope / sma50[10] * 100
c3_smaSlope = slope >= 0

// ── Criterion 4: Cutler's RSI (SMA-based, period 14) ───────────────────────
// JS: avgGain/avgLoss are simple averages; met = 40 <= rsi <= 60
chg      = close - close[1]
gain     = math.max(chg, 0)
loss     = math.max(-chg, 0)
avgGain  = ta.sma(gain, 14)
avgLoss  = ta.sma(loss, 14)
cutlerRSI = avgLoss == 0 ? 100.0 : 100.0 - 100.0 / (1.0 + avgGain / avgLoss)
c4_rsi = cutlerRSI >= 40 and cutlerRSI <= 60

// ── Criterion 5: Higher highs (local peaks over last 60 bars) ──────────────
// JS: local peak = close higher than 3 bars before AND after (== pivothigh 3,3).
//     met if >=1 higher high among peaks in last 60 bars; double if >=2.
pivot = ta.pivothigh(close, 3, 3)
var array<float> pivPrice = array.new<float>()
var array<int>   pivBar   = array.new<int>()
if not na(pivot)
    array.push(pivPrice, pivot)
    array.push(pivBar, bar_index - 3)   // pivot confirmed 3 bars back
// prune pivots older than 60 bars
while array.size(pivBar) > 0 and (bar_index - array.get(pivBar, 0)) > 60
    array.shift(pivPrice)
    array.shift(pivBar)
higherHighCount = 0
if array.size(pivPrice) >= 2
    for i = 1 to array.size(pivPrice) - 1
        if array.get(pivPrice, i) > array.get(pivPrice, i - 1)
            higherHighCount += 1
c5_higherHighs = higherHighCount >= 1

// ── Score & tier ───────────────────────────────────────────────────────────
metCount = (c1_sectorFlow ? 1 : 0) + (c2_consol ? 1 : 0) + (c3_smaSlope ? 1 : 0) + (c4_rsi ? 1 : 0) + (c5_higherHighs ? 1 : 0)
tier = metCount == 5 ? 1 : metCount >= 3 ? 2 : 0

// ── Plot a marker so it's visible on the chart ─────────────────────────────
plotshape(tier == 1, "Tier 1", shape.triangleup,   location.belowbar, color.new(color.green, 0),  size = size.small)
plotshape(tier == 2, "Tier 2", shape.triangleup,   location.belowbar, color.new(color.teal, 30),  size = size.tiny)

// ── Build the JSON webhook payload ─────────────────────────────────────────
f_b(b) => b ? "true" : "false"
stop = math.round(close * 0.94 * 100) / 100
json = '{' +
   '"secret":"'   + secret + '",' +
   '"ticker":"'   + syminfo.ticker + '",' +
   '"sector":"'   + sectorNm + '",' +
   '"sectorETF":"' + syminfo.ticker(sectorSym) + '",' +
   '"price":'     + str.tostring(math.round(close * 100) / 100) + ',' +
   '"stopLoss":'  + str.tostring(stop) + ',' +
   '"tier":'      + str.tostring(tier) + ',' +
   '"metCount":'  + str.tostring(metCount) + ',' +
   '"criteria":{' +
       '"sectorFlow":'    + f_b(c1_sectorFlow) + ',' +
       '"consolidation":' + f_b(c2_consol) + ',' +
       '"smaSlope":'      + f_b(c3_smaSlope) + ',' +
       '"cutlerRSI":'     + f_b(c4_rsi) + ',' +
       '"higherHighs":'   + f_b(c5_higherHighs) + '},' +
   '"values":{' +
       '"volChangePct":'    + str.tostring(math.round(volChange * 100)) + ',' +
       '"rangePct":'        + str.tostring(math.round(rangePercent * 100)) + ',' +
       '"smaSlopePct":'     + str.tostring(math.round(slopePct * 100) / 100) + ',' +
       '"rsi":'             + str.tostring(math.round(cutlerRSI * 10) / 10) + ',' +
       '"higherHighCount":' + str.tostring(higherHighCount) + '},' +
   '"time":"' + str.format_time(time, "yyyy-MM-dd", "America/New_York") + '"' +
   '}'

// Fire once per closed daily bar when the symbol qualifies (Tier 1 or 2).
if barstate.isconfirmed and tier > 0
    alert(json, alert.freq_once_per_bar_close)
